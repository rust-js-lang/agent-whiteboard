new file mode 100644
index 0000000..76c69eb
--- /dev/null
+++ b/test/react-compiler-output.test.ts
@@ -0,0 +1,103 @@
+import { beforeAll, expect, test } from "bun:test";
+import { readFileSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { buildReact, buildSerde, compiler, fixture, run, target } from "./support";
+import { underLoad } from "../scripts/timing";
+import { compiled, native } from "./serde-support";
+beforeAll(() => {
+  buildReact();
+  buildSerde("rlib");
+}, underLoad(120000));
+
+test("a callback whose body shadows its binding stays a lexical arrow for React Compiler", () => {
+  const dir = fixture("react-compiler-shadowed-callback");
+  writeFileSync(
+    join(dir, "lib.rs"),
+    `use react::{jsx, use_effect, JSX};
+use webapi::{events, window, EventTargetExt, KeyboardEvent};
+pub fn App() -> JSX::Element {
+    use_effect(|| {
+        let key = webapi::listener(|event: &KeyboardEvent| {
+            let key = event.key();
+            if key == "Escape" { event.prevent_default(); }
+        });
+        window.add_event_listener(events::Keydown, key, None);
+        move || window.remove_event_listener(events::Keydown, key, None)
+    }, Some(&()));
+    jsx! { <div>{"Draw freely"}</div> }
+}
+`,
+  );
+  run([
+    compiler,
+    join(dir, "lib.rs"),
+    "-o",
+    join(dir, "lib.jsx"),
+    "--",
+    "--extern",
+    `webapi=${join(target, "libwebapi.rmeta")}`,
+    "--extern",
+    `react=${join(target, "libreact.rmeta")}`,
+    "--extern",
+    `js=${join(target, "libjs.rmeta")}`,
+    "-L",
+    target,
+  ]);
+  const generated = readFileSync(join(dir, "lib.jsx"), "utf8");
+  expect(generated).toContain("const key = (event) =>");
+  expect(generated).not.toContain("function key(event)");
+  expect(generated).toContain("const key = event.key;");
+});
+
+test("shadowing an object parameter clones into a new local rather than assigning the parameter", () => {
+  const dir = fixture("react-compiler-shadowed-object");
+  writeFileSync(
+    join(dir, "lib.rs"),
+    `#[derive(Clone)]
+pub struct Point { pub x:f64, pub y:f64 }
+pub fn fork(point:&Point)->Point { let mut point=point.clone(); point.x+=1.0; point }
+`,
+  );
+  run([compiler, join(dir, "lib.rs"), "-o", join(dir, "lib.js")]);
+  const generated = readFileSync(join(dir, "lib.js"), "utf8");
+  expect(generated).not.toMatch(/^  point =/m);
+  expect(generated).toContain("{ ...point }");
+  writeFileSync(
+    join(dir, "run.js"),
+    `import {fork} from './lib.js';const source={x:2,y:3};const next=fork(source);if(source.x!==2||next.x!==3||next===source)throw Error('copy or source identity changed');`,
+  );
+  run(["bun", join(dir, "run.js")]);
+});
+
+test("mutable JSON places use an opaque handle constructor and retain native root replacement", async () => {
+  const dir = fixture("react-compiler-json-handle");
+  writeFileSync(
+    join(dir, "cases.rs"),
+    `use serde_json::{json,Value};
+pub fn report()->String { let mut value=Value::Null; value["mode"]=json!("browser"); value["nested"]["x"]=json!(2); let held=&mut value["nested"]["x"]; *held=json!(3); value.to_string() }
+`,
+  );
+  const expected = JSON.parse(run([native(dir)]));
+  const lib = await compiled(dir);
+  const generated = readFileSync(join(dir, "cases.js"), "utf8");
+  expect(generated).not.toContain("get value()");
+  expect(generated).not.toContain("set value(");
+  expect(generated).toContain("$handle(");
+  expect(lib.report()).toBe(expected);
+});
+
+test("shadowing a copied slice parameter also keeps its independent binding", () => {
+  const dir = fixture("react-compiler-shadowed-vector");
+  writeFileSync(
+    join(dir, "lib.rs"),
+    `pub fn fork(values:&[u32])->Vec<u32>{let mut values=values.to_vec();values.push(3);values}`,
+  );
+  run([compiler, join(dir, "lib.rs"), "-o", join(dir, "lib.js")]);
+  const generated = readFileSync(join(dir, "lib.js"), "utf8");
+  expect(generated).not.toMatch(/^  values =/m);
+  writeFileSync(
+    join(dir, "run.js"),
+    `import {fork} from './lib.js';const source=[1,2],next=fork(source);if(source.length!==2||next.length!==3||next===source)throw Error('array copy changed');`,
+  );
+  run(["bun", join(dir, "run.js")]);
+});
