+    pub struct WebGl2;
+    #[cfg_attr(rust_js, rust_js::name = "webgpu")]
+    #[derive(Clone, Copy)]
+    pub struct WebGpu;
+}
+impl CanvasContext for canvas_contexts::TwoD { type Output = &'static CanvasRenderingContext2D; }
+impl CanvasContext for canvas_contexts::BitmapRenderer { type Output = &'static ImageBitmapRenderingContext; }
