   expect(() => lib.bareScheduler()).toThrow(ReferenceError);
 });
+
+// A literal context request already supplies the type; DOM constructor identity is irrelevant.
+test("canvas context requests preserve their typed nullable result across realms", () => {
+  const withWeb = ["--", "--extern", `webapi=${join(target, "libwebapi.rmeta")}`, "--extern", `js=${join(target, "libjs.rmeta")}`, "-L", target];
+  const dir = fixture("typed-canvas-context");
+  writeFileSync(join(dir, "lib.rs"), `use webapi::{canvas_contexts, CanvasRenderingContext2D, HTMLCanvasElement, RenderingContext, WebGL2RenderingContext};
+pub fn context(canvas: &HTMLCanvasElement) -> Option<&'static CanvasRenderingContext2D> {
+    canvas.get_context(canvas_contexts::TwoD, None)
+}
+pub fn webgl(canvas: &HTMLCanvasElement) -> Option<&'static WebGL2RenderingContext> {
+    canvas.get_context(canvas_contexts::WebGl2, None)
+}
+pub fn dynamic(canvas: &HTMLCanvasElement, name: &str) -> Option<RenderingContext<'static>> {
+    canvas.get_context(name, None)
+}
+`);
+  run([compiler, join(dir, "lib.rs"), "-o", join(dir, "lib.js"), ...withWeb]);
+  const generated = readFileSync(join(dir, "lib.js"), "utf8");
+  expect(generated).toContain('canvas.getContext("2d")');
+  expect(generated).toContain('canvas.getContext("webgl2")');
+  expect(generated).not.toContain("instanceof");
+  writeFileSync(join(dir, "run.js"), `import { context, webgl, dynamic } from "./lib.js";
+const foreignContext = { fillRect() {} };
+const canvas = { getContext(kind) { return kind === "2d" ? foreignContext : null; } };
+if (context(canvas) !== foreignContext) throw Error("context identity was lost");
+if (webgl(canvas) != null) throw Error("nullability was lost");
+if (dynamic(canvas, "2d") !== foreignContext) throw Error("dynamic context changed");
+`);
+  run(["bun", join(dir, "run.js")]);
+});
