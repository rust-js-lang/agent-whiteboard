+    #[cfg_attr(rust_js, rust_js::name = "2d")]
+    #[derive(Clone, Copy)]
+    pub struct TwoD;
+    /// The image bitmap presentation context.
+    #[cfg_attr(rust_js, rust_js::name = "bitmaprenderer")]
+    #[derive(Clone, Copy)]
+    pub struct BitmapRenderer;
+    #[cfg_attr(rust_js, rust_js::name = "webgl")]
