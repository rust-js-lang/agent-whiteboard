@@ -143,3 +143,24 @@ test("check:fast keeps each failing job's whole output, a file each, in its run'
   expect(readdirSync(run!).sort()).toEqual(["corpus-6-14.log", "test-child.test.ts.log"]);
   expect(readFileSync(join(run!, "corpus-6-14.log"), "utf8")).toBe(log);
 });
+
+test("a submodule's main worktree is its checkout, not its Git metadata directory", () => {
+  const dir = realpathSync(fixture("strays-submodule"));
+  const parent = join(dir, "parent");
+  const source = join(dir, "source");
+  const git = (cwd: string, ...args: string[]) => {
+    const result = Bun.spawnSync(["git", ...args], { cwd, stdout: "pipe", stderr: "pipe" });
+    expect(result.exitCode, result.stderr.toString()).toBe(0);
+  };
+  for (const path of [parent, source]) {
+    mkdirSync(path);
+    git(path, "init", "-q");
+    git(path, "-c", "user.name=t", "-c", "user.email=t@t", "commit", "-q", "--allow-empty", "-m", "start");
+  }
+  git(parent, "-c", "protocol.file.allow=always", "submodule", "add", "-q", source, "dependency");
+  const dependency = join(parent, "dependency");
+  expect(worktreeRoots(dependency)).toEqual([dependency]);
+  const linked = join(dir, "linked");
+  git(dependency, "worktree", "add", "-q", "--detach", linked);
+  expect(worktreeRoots(linked)).toEqual([dependency, linked]);
+});
